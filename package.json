{
  "name": "omnyvox",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:setup": "node --env-file=.env.local --import tsx scripts/setup.ts",
    "format": "prettier --write app components lib tests scripts *.ts *.json *.md docs/*.md",
    "db:seed-marketing": "node --env-file=.env.local --import tsx scripts/seed-marketing.ts",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/run-migrations.ts",
    "worker:maintenance": "node --env-file=.env.local --import tsx scripts/maintenance.ts",
    "worker:ai": "node --env-file=.env.local --import tsx scripts/ai-worker.ts",
    "worker:email": "node --env-file=.env.local scripts/send-email.mjs",
    "test:recipients": "node --import tsx scripts/recipients-test.ts",
    "test:provision": "node --import tsx scripts/provision-test.ts",
    "test:security": "node --import tsx scripts/launch-readiness-test.ts",
    "test:billing": "node --import tsx scripts/billing-lifecycle-test.ts",
    "samples:generate": "tsx scripts/generate-samples.ts",
    "test:payment-review": "node --import tsx scripts/payment-review-test.ts",
    "test:store": "node --import tsx scripts/store-test.ts",
    "test:sites": "node --import tsx scripts/sites-content-test.ts",
    "test:plan-change": "node --import tsx scripts/plan-change-test.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-text-align": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "2.17.7",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.1",
    "prettier": "3.9.8",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "type": "module",
  "engines": {
    "node": ">=26.9.0"
  }
}
