DATABASE_URL=postgresql://omnyvox:omnyvox@localhost:5432/omnyvox
APP_URL=http://localhost:3000
PLATFORM_DOMAIN=localhost
PAYSTACK_SECRET_KEY=
ADMIN_EMAIL=

# Stable 32-byte hex key for AES-256-GCM merchant, recurring-payment and MFA secrets.
# Back it up securely; never replace it without migrating encrypted data.
ENCRYPTION_KEY=
# Edge provider provisioning is required before marking a custom domain active.
RESEND_API_KEY=
EMAIL_FROM=Omnyvox <hello@your-verified-domain.com>

# Persist and back up this 32-byte hex key before connecting Bunny Storage.
# If omitted, storage encryption uses ENCRYPTION_KEY.
STORAGE_ENCRYPTION_KEY=
# AI is opt-in, same-VPS only. Admin readiness approval is also required.
AI_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NO_CLOUD=1
